# PoLingvo environment (ТЗ п.11). Copy to .env for local dev; on Cloud Run
# secrets come from Secret Manager (see .github/workflows/deploy.yml).

# Gemini
GEMINI_API_KEY=
# Model is a single env switch (ТЗ п.3): upgrade = change this value.
GEMINI_MODEL=gemini-flash-latest

# Google Cloud / Firestore (leave USE_FIRESTORE empty locally → in-memory store)
GOOGLE_CLOUD_PROJECT=
USE_FIRESTORE=

# Stripe
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_LINK_URL=

# Product knobs
PRICE_ILS=10
FREE_CREDITS=1
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_HOUR=5
CONFIDENCE_THRESHOLD=0.7
